# /etc/kandado/kandado.env on the droplet (decision 16). Owned by root, group
# kandado, mode 640: it holds the database password and the token secret.
#   sudo install -d -m 750 -o root -g kandado /etc/kandado
#   sudo install -m 640 -o root -g kandado kandado.env.example /etc/kandado/kandado.env
#   sudoedit /etc/kandado/kandado.env
# Never commit the filled-in file.

# Only nginx talks to the server, on this machine. Hatian keeps its own port.
KANDADO_BIND=127.0.0.1:8081
KANDADO_LOG_FORMAT=json

# The address people and apps use. Google redirects to
# {KANDADO_PUBLIC_URL}/v1/auth/google/callback, and secure links start with it.
KANDADO_PUBLIC_URL=https://KANDADO_HOST

# A database and role in Hatian's PostgreSQL (version 18 or later), on this machine.
# Migrations run when the server starts.
DATABASE_URL=postgres://kandado:CHANGE_ME@127.0.0.1:5432/kandado
KANDADO_DB_MAX_CONNECTIONS=10

# Signs access tokens. 32 or more random characters, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out of their current access token (they refresh).
KANDADO_TOKEN_SECRET=CHANGE_ME

# Google sign-in is not here: the deploy pipeline writes GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET from GitHub secrets to /opt/kandado/config/google.env.

# The browser extensions' sign-in redirect hosts, comma separated,
# e.g. <extension id>.chromiumapp.org. Filled in when the store IDs exist (P10).
KANDADO_EXTENSION_REDIRECT_HOSTS=

# The secure link viewer, shipped inside each release.
KANDADO_VIEWER_DIR=/opt/kandado/current/viewer
