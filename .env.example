# Copy to .env for local development. These values match src/backend/docker-compose.yml
# and are for a database that only listens on this machine.
DATABASE_URL=postgres://kandado:kandado@127.0.0.1:54329/kandado
KANDADO_BIND=127.0.0.1:8080
KANDADO_LOG_FORMAT=text
# Signs access tokens. Any random string of 32 or more characters. Development value only.
KANDADO_TOKEN_SECRET=development-only-secret-change-me-0123456789
# Stands in for Google in local work and tests. Debug builds only.
KANDADO_DEV_AUTH=1
# Real Google sign-in: create an OAuth client (type "Web application") whose
# redirect URI is {KANDADO_PUBLIC_URL}/v1/auth/google/callback.
KANDADO_PUBLIC_URL=http://127.0.0.1:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Extension redirect hosts, comma separated (for example <extension id>.chromiumapp.org).
# KANDADO_EXTENSION_REDIRECT_HOSTS=
# The secure link viewer, built by node scripts/build-viewer.mjs. Empty turns /l/{id} off.
# KANDADO_VIEWER_DIR=src/backend/viewer/dist
